# Auto detect text files and perform LF normalization
* text=auto
# Retrieval index fingerprints include the raw bytes of these files.
scripts/retrieval.py text eol=lf
config/retrieval.json text eol=lf
# Preserve the recorded SHA-256 of the frozen evaluation dataset.
eval/test_questions.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
