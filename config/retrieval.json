{
  "version": "development-baseline-v1",
  "chunks_path": "audit/chunking/chunks.jsonl",
  "output_dir": "audit/retrieval",
  "text_format": "chunk.text only; no added metadata",
  "tie_break": "chunk_id ascending",
  "bm25": {
    "k1": 1.5,
    "b": 0.75,
    "token_pattern": "[a-z0-9]+",
    "lowercase": true,
    "stopwords": false,
    "stemming": false,
    "query_term_frequency": "unique",
    "idf": "log(1 + (N - df + 0.5)/(df + 0.5))"
  },
  "dense": {
    "model_id": "BAAI/bge-small-en-v1.5",
    "revision": "5c38ec7c405ec4b44b94cc5a9bb96e735b38267a",
    "model_dir": "audit/retrieval/model",
    "query_instruction": "Represent this sentence for searching relevant passages: ",
    "pooling": "cls",
    "normalize": true,
    "similarity": "cosine_exact",
    "device": "cpu",
    "dtype": "float32",
    "threads": 1,
    "batch_size": 16,
    "max_tokens": 500,
    "embedding_dimension": 384,
    "repeat_atol": 0.000001,
    "repeat_rtol": 0.00001
  }
}
